#!/bin/sh
# Chronicle launcher. Finds a Python new enough to run it and says so plainly if it can't.
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for PY in "${CHRONICLE_PYTHON:-}" python3 python3.13 python3.12 python3.11 python; do
    [ -n "$PY" ] || continue
    command -v "$PY" >/dev/null 2>&1 || continue
    if "$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
        PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m chronicle.cli "$@"
    fi
done
echo "chronicle: needs Python 3.11 or newer." >&2
echo "Found: $(python3 --version 2>&1 || echo 'no python3 on PATH')" >&2
echo "Set CHRONICLE_PYTHON=/path/to/python3.11 if you have one elsewhere." >&2
exit 1
